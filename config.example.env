# Facebook Page posting
FACEBOOK_PAGE_ID=123456789012345
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_USER_ACCESS_TOKEN=EAAG...
FACEBOOK_APP_ID=123456789012345
FACEBOOK_APP_SECRET=your-app-secret
FACEBOOK_TOKEN_CACHE_PATH=scratch/facebook_tokens.json
# Refreshed tokens are also synced to this R2 key, not just the local path
# above — GitHub Actions runners are ephemeral, so a local-only cache would
# silently lose a refreshed token at the end of every run.
FACEBOOK_TOKEN_R2_KEY=state/facebook_tokens.json
CAPTIONS_FILE_PATH=captions.txt
FIXED_CAPTION=Ace11Plus helps families build 11+ confidence step by step.
GRAPH_API_VERSION=v19.0
POSTS_PER_RUN=1

# Instagram Reels posting (optional — leave INSTAGRAM_USER_ID blank to skip).
# Authenticated via its OWN, independent Facebook Developer App — separate
# from the FACEBOOK_* credentials above. Two modes, same shape as Facebook:
#   simple (recommended to start): set INSTAGRAM_PAGE_ACCESS_TOKEN directly.
#   auto-refreshing: set INSTAGRAM_USER_ACCESS_TOKEN + INSTAGRAM_APP_ID +
#     INSTAGRAM_APP_SECRET + INSTAGRAM_PAGE_ID instead, and the script
#     refreshes/persists it the same way it does for Facebook.
INSTAGRAM_USER_ID=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_USER_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_ID=
INSTAGRAM_TOKEN_CACHE_PATH=scratch/instagram_tokens.json
INSTAGRAM_TOKEN_R2_KEY=state/instagram_tokens.json

# YouTube Shorts posting (optional — leave any of these blank to skip).
# Obtain YOUTUBE_REFRESH_TOKEN once via: python scripts/youtube_auth_setup.py
# (requires a Google Cloud OAuth "Desktop app" client with the YouTube Data
# API v3 enabled — see README.md).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=public

# Cloudflare R2
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ace11plus-assets
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_REELS_PREFIX=reels/
R2_MUSIC_PREFIX=music/

# Local upload paths (Windows)
LOCAL_REELS_DIR=C:\Users\ssjag\OneDrive\Ace11Plus\reels
LOCAL_MUSIC_DIR=C:\Users\ssjag\OneDrive\Ace11Plus\music
